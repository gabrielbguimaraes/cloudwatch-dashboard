# ==============================================================================
# CloudWatch Dashboard Mobile (React Native) - Configuracao por Build
# Copie para .env ou defina no ambiente antes do build Metro/Gradle.
# O babel.config.js injeta apenas estas variaveis publicas no bundle em tempo de build.
# NUNCA inclua chaves privadas ou segredos do servidor no aplicativo mobile.
# ==============================================================================

# URL publica base do BFF (em producao deve obrigatoriamente usar https://)
# Em desenvolvimento local no Android Emulator, o fallback automatico em __DEV__ e http://10.0.2.2:3000
CLOUDWATCH_PUBLIC_BASE_URL=https://api.seu-dominio.exemplo.com

# Endpoint REST base da API (se omitido, assume ${CLOUDWATCH_PUBLIC_BASE_URL}/api)
CLOUDWATCH_API_BASE_URL=https://api.seu-dominio.exemplo.com/api
