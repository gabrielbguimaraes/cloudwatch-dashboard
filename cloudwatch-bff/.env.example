# ==============================================================================
# CloudWatch Dashboard - Backend For Frontend (BFF)
# Copie este arquivo para .env e preencha com valores reais do ambiente.
# NUNCA comite o arquivo .env com segredos reais no repositorio.
# ==============================================================================

PORT=3000
# Em producao atras do Caddy/Nginx na mesma VM, mantenha 127.0.0.1 para nao expor HTTP sem TLS na rede externa
BIND_HOST=127.0.0.1
NODE_ENV=development

# URL publica do BFF (obrigatorio usar https:// em producao para o pareamento por codigo)
PUBLIC_BASE_URL=https://api.seu-dominio.exemplo.com

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudwatch_db
DB_USER=cloudwatch_user
DB_PASSWORD=

# Segredo de assinatura JWT (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Chave simetrica AES-256-GCM para criptografar credenciais OCI no banco (32 bytes = 64 caracteres hex)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENC_KEY=

# Origens web permitidas por CORS separadas por virgula (vazio bloqueia origens de navegador e permite app nativo)
CORS_ORIGINS=

# Username no app pertencente ao dono da VM OCI (unico autorizado a usar Instance Principal demo e inspecao Docker local)
OWNER_USERNAME=

